<style>
  /* ==================== NAVBAR MODERNE ==================== */
  .modern-navbar {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 0;
    transition: all 0.3s ease;
  }

  .modern-navbar.scrolled {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.12);
    padding: 0.5rem 0;
  }

  /* Logo moderne */
  .navbar-brand-modern {
    font-size: 1.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
    transition: all 0.3s ease;
  }

  .navbar-brand-modern:hover {
    transform: scale(1.05);
  }

  /* Navigation links */
  .nav-link-modern {
    color: #1e293b !important;
    font-weight: 500;
    padding: 0.5rem 1rem !important;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-link-modern::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    transition: width 0.3s ease;
  }

  .nav-link-modern:hover::after,
  .nav-link-modern.active::after {
    width: 70%;
  }

  .nav-link-modern:hover {
    background: rgba(59, 130, 246, 0.08);
    color: #3b82f6 !important;
  }

  /* Dropdown moderne */
  .dropdown-modern .dropdown-menu {
    border: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
    border-radius: 1rem;
    padding: 0.75rem;
    margin-top: 0.5rem;
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-item-modern {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    color: #475569;
  }

  .dropdown-item-modern:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    color: #3b82f6;
    transform: translateX(5px);
  }

  .dropdown-item-modern i {
    transition: transform 0.2s ease;
  }

  .dropdown-item-modern:hover i {
    transform: scale(1.2);
  }

  /* Panier moderne */
  .cart-modern {
    position: relative;
  }

  .cart-link-modern {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 50%;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .cart-link-modern:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    color: white;
  }

  .cart-link-modern i {
    font-size: 1.3rem;
  }

  .cart-badge-modern {
    position: absolute;
    top: -5px;
    right: -5px;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.45rem;
    border-radius: 50%;
    min-width: 20px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  /* Boutons modernes */
  .btn-modern-primary {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    color: white;
    padding: 0.6rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .btn-modern-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    color: white;
  }

  .btn-modern-outline {
    border: 2px solid #3b82f6;
    color: #3b82f6;
    padding: 0.6rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 600;
    background: transparent;
    transition: all 0.3s ease;
  }

  .btn-modern-outline:hover {
    background: #3b82f6;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  /* Icônes mobiles */
  .icon-btn-modern {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.2rem;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    cursor: pointer;
  }

  .icon-btn-modern:hover,
  .icon-btn-modern.active {
    transform: translateY(-3px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
  }

  .icon-btn-modern.active {
    background: linear-gradient(135deg, #ef4444, #dc2626);
  }

  /* Panel mobile générique */
  .mobile-panel-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1040;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-panel-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-panel {
    position: fixed;
    top: -100%;
    left: 0;
    right: 0;
    background: white;
    z-index: 1050;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 90vh;
    overflow-y: auto;
  }

  .mobile-panel.active {
    top: 0;
  }

  .mobile-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .mobile-panel-header h5 {
    margin: 0;
    color: #1e293b;
    font-weight: 700;
    font-size: 1.3rem;
  }

  .close-panel-btn {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #f1f5f9;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    font-size: 1.3rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .close-panel-btn:hover {
    background: #ef4444;
    color: white;
    transform: rotate(90deg);
  }

  /* Search panel mobile */
  .search-modern-mobile {
    position: relative;
  }

  .search-modern-mobile input {
    border: 2px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem 0.85rem 3rem;
    transition: all 0.3s ease;
    background: #f8fafc;
    width: 100%;
    font-size: 1rem;
  }

  .search-modern-mobile input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    background: white;
    outline: none;
  }

  .search-modern-mobile i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
    font-size: 1.2rem;
  }

  /* Auth panel mobile */
  .auth-buttons-mobile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .auth-buttons-mobile .btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    border-radius: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .auth-btn-login {
    background: white;
    border: 2px solid #3b82f6;
    color: #3b82f6;
  }

  .auth-btn-login:hover {
    background: #3b82f6;
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
  }

  .auth-btn-register {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    color: white;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .auth-btn-register:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    color: white;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    margin: 1.5rem 0;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  .auth-divider::before {
    margin-right: 1rem;
  }

  .auth-divider::after {
    margin-left: 1rem;
  }

  .auth-info {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05), rgba(139, 92, 246, 0.05));
    padding: 1rem;
    border-radius: 0.75rem;
    margin-top: 1.5rem;
    border: 1px solid rgba(59, 130, 246, 0.1);
  }

  .auth-info p {
    margin: 0;
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .auth-info i {
    color: #3b82f6;
    margin-right: 0.5rem;
  }

  /* Search bar moderne (desktop) */
  .search-modern {
    position: relative;
    max-width: 400px;
  }

  .search-modern input {
    border: 2px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.65rem 1rem 0.65rem 2.5rem;
    transition: all 0.3s ease;
    background: #f8fafc;
  }

  .search-modern input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    background: white;
  }

  .search-modern i {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: #475569;
    font-size: 1.1rem;
  }

  .search-modern button {
    border-radius: 0.75rem;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border: none;
    padding: 0.65rem 1.5rem;
    font-weight: 600;
    transition: all 0.3s ease;
    color: white;
  }

  .search-modern button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  /* Dashboard link moderne */
  .dashboard-link-modern {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    border-radius: 0.75rem;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .dashboard-link-modern:hover {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  /* Hamburger animé */
  .custom-toggler {
    border: none;
    background: transparent;
    width: 35px;
    height: 30px;
    position: relative;
    cursor: pointer;
    padding: 0;
  }

  .toggler-icon {
    display: block;
    height: 3px;
    width: 100%;
    background: #3b82f6;
    border-radius: 3px;
    transition: all 0.3s ease;
    position: absolute;
    left: 0;
  }

  .toggler-icon:nth-child(1) {
    top: 0;
  }

  .toggler-icon:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }

  .toggler-icon:nth-child(3) {
    bottom: 0;
  }

  .custom-toggler.active .toggler-icon:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .custom-toggler.active .toggler-icon:nth-child(2) {
    opacity: 0;
  }

  .custom-toggler.active .toggler-icon:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* Responsive */
  @media (max-width: 991px) {
    .navbar-collapse {
      background: white;
      margin-top: 1rem;
      padding: 1rem;
      border-radius: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .nav-link-modern::after {
      display: none;
    }
  }

  /* Effet de scroll */
  body {
    padding-top: 80px;
  }
</style>

