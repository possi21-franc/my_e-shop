<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Animation hamburger
    const toggler = document.querySelector(".custom-toggler");
    toggler.addEventListener("click", function () {
      this.classList.toggle("active");
    });

    // Effet scroll navbar
    const navbar = document.getElementById("mainNavbar");
    window.addEventListener("scroll", function () {
      if (window.scrollY > 50) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });

    // Ferme le menu mobile au clic sur un lien
    const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
    const navCollapse = document.getElementById('navbarScroll');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 992) {
          const bsCollapse = new bootstrap.Collapse(navCollapse, {
            toggle: false
          });
          bsCollapse.hide();
          toggler.classList.remove('active');
        }
      });
    });

    // Gestion de la recherche mobile
    const mobileSearchToggle = document.getElementById('mobileSearchToggle');
    const mobileSearchPanel = document.getElementById('mobileSearchPanel');
    const mobileSearchOverlay = document.getElementById('mobileSearchOverlay');
    const closeMobileSearch = document.getElementById('closeMobileSearch');

    // Gestion de l'authentification mobile
    const mobileAuthToggle = document.getElementById('mobileAuthToggle');
    const mobileAuthPanel = document.getElementById('mobileAuthPanel');
    const mobileAuthOverlay = document.getElementById('mobileAuthOverlay');
    const closeMobileAuth = document.getElementById('closeMobileAuth');

    function openMobileSearch() {
      mobileSearchPanel.classList.add('active');
      mobileSearchOverlay.classList.add('active');
      mobileSearchToggle.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        mobileSearchPanel.querySelector('input').focus();
      }, 400);
    }

    function closeMobileSearchPanel() {
      mobileSearchPanel.classList.remove('active');
      mobileSearchOverlay.classList.remove('active');
      mobileSearchToggle.classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    function openMobileAuth() {
      mobileAuthPanel.classList.add('active');
      mobileAuthOverlay.classList.add('active');
      if (mobileAuthToggle) {
        mobileAuthToggle.classList.add('active');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeMobileAuthPanel() {
      mobileAuthPanel.classList.remove('active');
      mobileAuthOverlay.classList.remove('active');
      if (mobileAuthToggle) {
        mobileAuthToggle.classList.remove('active');
      }
      document.body.style.overflow = 'auto';
    }

    // Event listeners pour la recherche
    if (mobileSearchToggle) {
      mobileSearchToggle.addEventListener('click', openMobileSearch);
    }
    if (closeMobileSearch) {
      closeMobileSearch.addEventListener('click', closeMobileSearchPanel);
    }
    if (mobileSearchOverlay) {
      mobileSearchOverlay.addEventListener('click', closeMobileSearchPanel);
    }

    // Event listeners pour l'authentification
    if (mobileAuthToggle) {
      mobileAuthToggle.addEventListener('click', openMobileAuth);
    }
    if (closeMobileAuth) {
      closeMobileAuth.addEventListener('click', closeMobileAuthPanel);
    }
    if (mobileAuthOverlay) {
      mobileAuthOverlay.addEventListener('click', closeMobileAuthPanel);
    }

    // Fermer avec Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (mobileSearchPanel && mobileSearchPanel.classList.contains('active')) {
          closeMobileSearchPanel();
        }
        if (mobileAuthPanel && mobileAuthPanel.classList.contains('active')) {
          closeMobileAuthPanel();
        }
      }
    });
  });


// mise à jour dynamique du panier
 // Mettre à jour le badge depuis le serveur
function updateCartBadge() {
    fetch('/cart/count', { headers: { "X-Requested-With": "XMLHttpRequest" }})
        .then(res => res.json())
        .then(data => {
            const count = data.count;
            const badges = document.querySelectorAll("#cart-count, #cart-count-mobile, #cart-count-desktop");

            badges.forEach(badge => {
                if (!badge) return;

                badge.textContent = count;

                // Si aucun produit => cacher badge
                if (count > 0) {
                    badge.style.display = "inline-flex"; // Affiche le badge
                } else {
                    badge.style.display = "none"; // Cache complètement
                }
            });
        })
        .catch(err => console.error("Erreur difficulté badge panier :", err));
}

 function showToast(message = "Produit ajouté au panier ✅") {
    const toast = document.getElementById("cart-toast");
    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 2500); // disparaît après 2.5s
}


// Initialisation au chargement
document.addEventListener("DOMContentLoaded", updateCartBadge);

// Actions sur le panier : add, remove, decrease, clear
document.addEventListener("click", function(e) {
    let target = e.target.closest(".add-cart-btn, .remove-cart-btn, .decrease-cart-btn, .clear-cart-btn");
    if (target) {
        e.preventDefault();
        const url = target.getAttribute("href");
        fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" }})
            .then(res => res.json())
            .then(data => {
                // Mettre à jour badge
                updateCartBadge();
                 showToast();
                // Animation optionnelle
                const cartIcon = document.getElementById("cart-count");
                if (cartIcon) {
                    cartIcon.classList.add("cart-bounce");
                    setTimeout(() => cartIcon.classList.remove("cart-bounce"), 600);
                }
            });
    }
});


</script>